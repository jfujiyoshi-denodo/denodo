00')) THEN to_timestamptz('yyyy-MM-dd''T''HH:mm:ss.SSS', '2026-07-28T13:23:30.213+0000') WHEN (connection_start_time between to_timestamptz('yyyy-MM-dd''T''HH:mm:ss.SSS', '2026-07-28T13:23:30.214+0000') AND to_timestamptz('yyyy-MM-dd''T''HH:mm:ss.SSS', '2026-07-28T13:35:17.988+0000')) THEN to_timestamptz('yyyy-MM-dd''T''HH:mm:ss.SSS', '2026-07-28T13:35:17.987+0000') ELSE NULL END AS connection_end_time, nullif(client_ip, '-') AS client_ip, nullif(user_agent, '-') AS user_agent, nullif(access_interface, '-') AS access_interface, session_id, session_start_time, case WHEN (notification_type not in ('loginOk', 'openSession')) THEN session_end_time WHEN (session_start_time < to_timestamptz('yyyy-MM-dd''T''HH:mm:ss.SSS', '2026-07-23T09:32:02.820+0000')) THEN to_timestamptz('yyyy-MM-dd''T''HH:mm:ss.SSS', '2026-07-23T09:32:02.819+0000') WHEN (session_start_time between to_timestamptz('yyyy-MM-dd''T''HH:mm:ss.SSS', '2026-07-23T09:32:02.820+0000') AND to_timestamptz('yyyy-MM-dd''T''HH:mm:ss.SSS', '2026-07-24T11:55:13.377+0000')) THEN to_timestamptz('yyyy-MM-dd''T''HH:mm:ss.SSS', '2026-07-24T11:55:13.376+0000') WHEN (session_start_time between to_timestamptz('yyyy-MM-dd''T''HH:mm:ss.SSS', '2026-07-24T11:55:13.377+0000') AND to_timestamptz('yyyy-MM-dd''T''HH:mm:ss.SSS', '2026-07-27T11:16:50.375+0000')) THEN to_timestamptz('yyyy-MM-dd''T''HH:mm:ss.SSS', '2026-07-27T11:16:50.374+0000') WHEN (session_start_time between to_timestamptz('yyyy-MM-dd''T''HH:mm:ss.SSS', '2026-07-27T11:16:50.375+0000') AND to_timestamptz('yyyy-MM-dd''T''HH:mm:ss.SSS', '2026-07-28T09:13:57.840+0000')) THEN to_timestamptz('yyyy-MM-dd''T''HH:mm:ss.SSS', '2026-07-28T09:13:57.839+0000') WHEN (session_start_time between to_timestamptz('yyyy-MM-dd''T''HH:mm:ss.SSS', '2026-07-28T09:13:57.840+0000') AND to_timestamptz('yyyy-MM-dd''T''HH:mm:ss.SSS', '2026-07-28T12:36:59.306+0000')) THEN to_timestamptz('yyyy-MM-dd''T''HH:mm:ss.SSS', '2026-07-28T12:36:59.305+0000') WHEN (session_start_time between to_timestamptz('yyyy-MM-dd''T''HH:mm:ss.SSS', '2026-07-28T12:36:59.306+0000') AND to_timestamptz('yyyy-MM-dd''T''HH:mm:ss.SSS', '2026-07-28T13:17:42.048+0000')) THEN to_timestamptz('yyyy-MM-dd''T''HH:mm:ss.SSS', '2026-07-28T13:17:42.047+0000') WHEN (session_start_time between to_timestamptz('yyyy-MM-dd''T''HH:mm:ss.SSS', '2026-07-28T13:17:42.048+0000') AND to_timestamptz('yyyy-MM-dd''T''HH:mm:ss.SSS', '2026-07-28T13:23:30.214+0000')) THEN to_timestamptz('yyyy-MM-dd''T''HH:mm:ss.SSS', '2026-07-28T13:23:30.213+0000') WHEN (session_start_time between to_timestamptz('yyyy-MM-dd''T''HH:mm:ss.SSS', '2026-07-28T13:23:30.214+0000') AND to_timestamptz('yyyy-MM-dd''T''HH:mm:ss.SSS', '2026-07-28T13:35:17.988+0000')) THEN to_timestamptz('yyyy-MM-dd''T''HH:mm:ss.SSS', '2026-07-28T13:35:17.987+0000') ELSE NULL END AS session_end_time, nullif(login, '-') AS login, nullif(database_name, '-') AS database_name, nullif(webservice_name, '-') AS webservice_name, nullif(jms_queue_name, '-') AS jms_queue_name, nullif(intermediate_client_ip, '-') AS intermediate_client_ip, start_time, case WHEN (end_time is not null ) THEN end_time WHEN (start_time < to_timestamptz('yyyy-MM-dd''T''HH:mm:ss.SSS', '2026-07-23T09:32:02.820+0000')) THEN to_timestamptz('yyyy-MM-dd''T''HH:mm:ss.SSS', '2026-07-23T09:32:02.819+0000') WHEN (start_time between to_timestamptz('yyyy-MM-dd''T''HH:mm:ss.SSS', '2026-07-23T09:32:02.820+0000') AND to_timestamptz('yyyy-MM-dd''T''HH:mm:ss.SSS', '2026-07-24T11:55:13.377+0000')) THEN to_timestamptz('yyyy-MM-dd''T''HH:mm:ss.SSS', '2026-07-24T11:55:13.376+0000') WHEN (start_time between to_timestamptz('yyyy-MM-dd''T''HH:mm:ss.SSS', '2026-07-24T11:55:13.377+0000') AND to_timestamptz('yyyy-MM-dd''T''HH:mm:ss.SSS', '2026-07-27T11:16:50.375+0000')) THEN to_timestamptz('yyyy-MM-dd''T''HH:mm:ss.SSS', '2026-07-27T11:16:50.374+0000') WHEN (start_time between to_timestamptz('yyyy-MM-dd''T''HH:mm:ss.SSS', '2026-07-27T11:16:50.375+0000') AND to_timestamptz('yyyy-MM-dd''T''HH:mm:ss.SSS', '2026-07-28T09:13:57.840+0000')) THEN to_timestamptz('yyyy-MM-dd''T''HH:mm:ss.SSS', '2026-07-28T09:13:57.839+0000') WHEN (start_time between to_timestamptz('yyyy-MM-dd''T''HH:mm:ss.SSS', '2026-07-28T09:13:57.840+0000') AND to_timestamptz('yyyy-MM-dd''T''HH:mm:ss.SSS', '2026-07-28T12:36:59.306+0000')) THEN to_timestamptz('yyyy-MM-dd''T''HH:mm:ss.SSS', '2026-07-28T12:36:59.305+0000') WHEN (start_time between to_timestamptz('yyyy-MM-dd''T''HH:mm:ss.SSS', '2026-07-28T12:36:59.306+0000') AND to_timestamptz('yyyy-MM-dd''T''HH:mm:ss.SSS', '2026-07-28T13:17:42.048+0000')) THEN to_timestamptz('yyyy-MM-dd''T''HH:mm:ss.SSS', '2026-07-28T13:17:42.047+0000') WHEN (start_time between to_timestamptz('yyyy-MM-dd''T''HH:mm:ss.SSS', '2026-07-28T13:17:42.048+0000') AND to_timestamptz('yyyy-MM-dd''T''HH:mm:ss.SSS', '2026-07-28T13:23:30.214+0000')) THEN to_timestamptz('yyyy-MM-dd''T''HH:mm:ss.SSS', '2026-07-28T13:23:30.213+0000') WHEN (start_time between to_timestamptz('yyyy-MM-dd''T''HH:mm:ss.SSS', '2026-07-28T13:23:30.214+0000') AND to_timestamptz('yyyy-MM-dd''T''HH:mm:ss.SSS', '2026-07-28T13:35:17.988+0000')) THEN to_timestamptz('yyyy-MM-dd''T''HH:mm:ss.SSS', '2026-07-28T13:35:17.987+0000') ELSE NULL END AS end_time FROM sessions_interval_log_20260728160131555 CONTEXT ('I18N' = 'rfc_restful');

