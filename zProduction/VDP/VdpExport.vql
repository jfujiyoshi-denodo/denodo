DROP VIEW IF EXISTS denodo_loader CASCADE;

CREATE TABLE denodo_loader I18N jp (
        yearmonth:text (sourcetypeid = '-9', sourcetyperadix = '10', sourcetypedecimals = '0', sourcetypesize = '2147483647'),
        cd:text (sourcetypeid = '-9', sourcetyperadix = '10', sourcetypedecimals = '0', sourcetypesize = '2147483647'),
        name:text (sourcetypeid = '-9', sourcetyperadix = '10', sourcetypedecimals = '0', sourcetypesize = '2147483647'),
        address:text (sourcetypeid = '-9', sourcetyperadix = '10', sourcetypedecimals = '0', sourcetypesize = '2147483647'),
        sales:decimal (sourcetypeid = '2', sourcetyperadix = '10')
    )
    CACHE OFF
    TIMETOLIVEINCACHE DEFAULT
    ADD SEARCHMETHOD denodo_loader(
        I18N jp
        CONSTRAINTS (
             ADD yearmonth (any) OPT ANY
             ADD cd (any) OPT ANY
             ADD name (any) OPT ANY
             ADD address (any) OPT ANY
             ADD sales (any) OPT ANY
        )
        OUTPUTLIST (address, cd, name, sales, yearmonth
        )
        WRAPPER (jdbc denodo_loader)
    );

CHOWN admin VIEW denodo_loader LASTMODIFICATIONUSER admin;

DROP VIEW IF EXISTS "基本_予算" CASCADE;

