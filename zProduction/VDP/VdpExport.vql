DROP VIEW IF EXISTS threads_log_20260728160131555 CASCADE;

CREATE VIEW threads_log_20260728160131555 FOLDER = '/20260728160131555/threads' (
    stack_trace (sourcetypeid = '2005')
 )
 AS SELECT date, name, id, case WHEN (len(lock_object) > 32672) THEN substr(lock_object, (len(lock_object)-32672)) ELSE lock_object END AS lock_object, lock_owner_id, lock_owner_name, previous_cpu_time, cpu_time, elapsed_cpu_time, elapsed_time, cpu_usage, in_native, suspended, in_deadlock, state, (case WHEN (len(stack_trace) > 32672) THEN substr(stack_trace, ((len(stack_trace)-32672)-1)) ELSE stack_trace END||'') AS stack_trace FROM FLATTEN parsed_threads_instant_log_20260728160131555 AS v ( v.thread_dump) CONTEXT ('I18N' = 'rfc_restful');

CHOWN admin VIEW threads_log_20260728160131555 LASTMODIFICATIONUSER admin;

ALTER VIEW threads_log_20260728160131555
 CACHE FULL
    BATCHSIZEINCACHE DEFAULT TIMETOLIVEINCACHE NOEXPIRE
     DECLARE CACHE INDEX threads_20260728160131555_date_idx ON (date ASC);

