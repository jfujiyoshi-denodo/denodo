# #######################################
DROP WRAPPER MONGODB IF EXISTS report CASCADE;

CREATE WRAPPER MONGODB report
    DATASOURCENAME="源泉_pj日報"
    DATABASE = 'demo'
    COLLECTION = 'report'
    LIMITDOCUMENTS = 150
    OUTPUTSCHEMA (
        _id = '_id' : 'java.lang.String' SORTABLE NOT UPDATEABLE,
        "現場責任者" = 'supervisor' : 'java.lang.String' SORTABLE,
        "日報対象日" = 'date' : 'java.lang.String' SORTABLE,
        "プロジェクト管理ID" = 'project_id' : 'java.lang.String' SORTABLE,
        "現場状況メモ" = 'site_status_note' : 'java.lang.String' SORTABLE
    );

CHOWN admin WRAPPER MONGODB report LASTMODIFICATIONUSER admin;

