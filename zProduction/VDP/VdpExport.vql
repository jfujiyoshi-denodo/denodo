# BASE VIEWS of const
# #######################################
DROP VIEW IF EXISTS "基本_日報" CASCADE;

CREATE TABLE "基本_日報" I18N jp (
        "プロジェクト管理ID":text (description = '日報が紐づく工事や案件を識別するための管理用IDを保持するフィールドです。組織内の他システムや台帳で用いられるプロジェクト識別子と連携させることで、進捗・原価・品質などの各種情報を一貫して追跡・照合できるようにします。'),
        "日報対象日":text (description = 'この日報が対象としている日付を表すフィールドです。日々の作業内容や現場状況をカレンダー上の特定の日と結びつけて管理し、期間別の集計や履歴参照、報告サイクルの管理などに活用されます。'),
        "現場責任者":text (description = '当該日の日報内容を取りまとめる現場責任者や監督者の氏名・識別情報を格納するフィールドです。担当者ごとの指揮系統や責任範囲を明確にし、問い合わせ先の特定や承認プロセス、評価・指導の基礎情報として利用されます。'),
        "現場状況メモ":text (description = '当日の現場の状況や特記事項を自由記述で記録するフィールドです。作業の進捗、品質上の懸念点、安全面での出来事、環境条件、トラブルやリスクなどを詳細に残し、関係者間の情報共有や後日の原因分析・改善活動の材料とします。')
    )
    DESCRIPTION = '日報ビュー「日報」は、工事・案件単位で日々の現場状況を記録・管理するためのビューです。各行は「プロジェクト管理ID」によって特定の工事・案件と紐づけられ、「日報対象日」によってどの日の記録かが判別できる構造になっています。「現場責任者」には、その日の日報を取りまとめた現場責任者・監督者の情報が格納され、「現場状況メモ」には作業の進捗状況、品質や安全面での出来事、トラブルやリスク、天候などの環境条件、その他の特記事項が自由記述で記録されます。これにより、プロジェクトごとの現場の状態を日付と担当者、具体的な状況メモの組み合わせで時系列に追跡できるようになっています。'
    PRIMARY KEY ( 'プロジェクト管理ID' , '日報対象日' )
    CACHE OFF
    TIMETOLIVEINCACHE DEFAULT
    ADD SEARCHMETHOD report(
        I18N jp
        CONSTRAINTS (
             ADD "プロジェクト管理ID" NOS ZERO ()
             ADD "日報対象日" NOS ZERO ()
             ADD "現場責任者" NOS ZERO ()
             ADD "現場状況メモ" NOS ZERO ()
        )
        OUTPUTLIST ("プロジェクト管理ID", "日報対象日", "現場状況メモ", "現場責任者"
        )
        WRAPPER (mongodb report)
    );

CHOWN admin VIEW "基本_日報" LASTMODIFICATIONUSER admin;

