+0000') WHEN (start_time between to_timestamptz('yyyy-MM-dd''T''HH:mm:ss.SSS', '2026-07-28T13:23:30.214+0000') AND to_timestamptz('yyyy-MM-dd''T''HH:mm:ss.SSS', '2026-07-28T13:35:17.988+0000')) THEN to_timestamptz('yyyy-MM-dd''T''HH:mm:ss.SSS', '2026-07-28T13:35:17.987+0000') ELSE NULL END AS end_time, case duration_as_text WHEN '-' THEN NULL ELSE cast('long', duration_as_text) END AS duration, case waiting_time_as_text WHEN '-' THEN NULL ELSE cast('long', waiting_time_as_text) END AS waiting_time, case num_rows_as_text WHEN '-' THEN NULL ELSE cast('long', num_rows_as_text) END AS num_rows, nullif(state, '-') AS state, case cache_as_text WHEN '-' THEN NULL ELSE cast('boolean', cache_as_text) END AS cache, substr(query FROM 1 FOR 32672) AS query, request_type, nullif(substr(elements FROM 1 FOR 32672), '-') AS elements, nullif(user_agent, '-') AS user_agent, access_interface, nullif(client_ip, '-') AS client_ip, case transaction_id_as_text WHEN '-' THEN NULL ELSE cast('long', transaction_id_as_text) END AS transaction_id, nullif(webservice_name, '-') AS webservice_name, case cpu_time WHEN '-' THEN NULL ELSE cast('long', cpu_time) END AS cpu_time, case cpu_usage_avg WHEN '-' THEN NULL ELSE cast('float', cpu_usage_avg) END AS cpu_usage_avg, case cpu_usage_max WHEN '-' THEN NULL ELSE cast('float', cpu_usage_max) END AS cpu_usage_max, case cpu_usage_std_dev WHEN '-' THEN NULL ELSE cast('float', cpu_usage_std_dev) END AS cpu_usage_std_dev, case cpu_usage_max_time WHEN '-' THEN NULL ELSE to_timestamptz('yyyy-MM-dd''T''HH:mm:ss.SSS', cpu_usage_max_time) END AS cpu_usage_max_time FROM requests_interval_log_20260728160131555 CONTEXT ('I18N' = 'rfc_restful');

