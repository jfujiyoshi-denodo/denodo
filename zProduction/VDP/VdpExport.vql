    FOLDER = '/管理'
    DATASOURCENAME="源泉_標準"
    PARAMETERS (
      'detectMimeType' = false
    )
    OUTPUTSCHEMA (
        parentfolder = 'parentfolder' : 'java.lang.String' (OBL) (sourcetypeid='12')  NOT NULL NOT SORTABLE,
        "relativePath" = 'relativePath' : 'java.lang.String' (OPT) (sourcetypeid='12')  SORTABLE,
        filename = 'filename' : 'java.lang.String' (OPT) (sourcetypeid='12')  SORTABLE,
        extension = 'extension' : 'java.lang.String' (OPT) (sourcetypeid='12')  SORTABLE,
        fullpath = 'fullpath' : 'java.lang.String' (OPT) (sourcetypeid='12')  SORTABLE,
        filetype = 'filetype' : 'java.lang.String' (OPT) (sourcetypeid='12')  SORTABLE,
        hidden = 'hidden' : 'java.lang.Boolean' (OPT) (sourcetypeid='16')  SORTABLE,
        datemodified = 'datemodified' : 'java.time.LocalDateTime' (OPT) (sourcetypeid='93')  SORTABLE,
        canread = 'canread' : 'java.lang.Boolean' (OPT) (sourcetypeid='16')  SORTABLE,
        canwrite = 'canwrite' : 'java.lang.Boolean' (OPT) (sourcetypeid='16')  SORTABLE,
        canexecute = 'canexecute' : 'java.lang.Boolean' (OPT) (sourcetypeid='16')  SORTABLE,
        size = 'size' : 'java.lang.Long' (OPT) (sourcetypeid='-5')  SORTABLE,
        recursive = 'recursive' : 'java.lang.Boolean' (OBL) (sourcetypeid='16')  NOT SORTABLE NOT UPDATEABLE,
        binarycontents = 'binarycontents' : 'java.sql.Blob' (sourcetypeid='2004')  NOT SORTABLE,
        textcontents = 'textcontents' : 'java.lang.String' (OPT) (sourcetypeid='12')  SORTABLE,
        readencoding = 'readencoding' : 'java.lang.String' (OPT) (sourcetypeid='12')  NOT SORTABLE NOT UPDATEABLE,
        append = 'append' : 'java.lang.Boolean' (sourcetypeid='16')  NOT SORTABLE,
        overwrite = 'overwrite' : 'java.lang.Boolean' (sourcetypeid='16')  NOT SORTABLE
    );

CHOWN admin WRAPPER CUSTOM "源泉_標準" LASTMODIFICATIONUSER admin;

DROP WRAPPER JSON IF EXISTS "源泉_JSON" CASCADE;

CREATE WRAPPER JSON "源泉_JSON"
    FOLDER = '/管理'
    DATASOURCENAME="源泉_JSON"
    TUPLEROOT '/JSONFile/JSONArray'
    OUTPUTSCHEMA ("JSONFile" = 'JSONFile' : REGISTER OF (
        "JSON_INPUT" = 'JSON_INPUT' : 'java.lang.String' (OBL) (DEFAULTVALUE='[
  {
    "document": "秘密保持契約書",
    "title_number": "第 1条",
    "title": "秘密情報",
    "sentences": "本契約において「秘密情報」とは、甲又は乙（以下「開示当事者」という）が、他方当事者（以下「受領当事者」という）に対し、本目的のために開示する技術上、営業上その他一切の情報をいう。ただし、次の各号のいずれかに該当する情報は秘密情報から除外される。1. 開示された時点で、既に公知であった情報 2. 開示された後、受領当事者の責によらずに公知となった情報 3. 開示される前に、受領当事者が既に適法に保有していた情報 4. 正当な権限を有する第三者から、秘密保持義務を負うことなく適法に入手した情報"
  },
  {
    "document": "秘密保持契約書",
    "title_number": "第 2条",
    "title": "秘密保持",
    "sentences": "受領当事者は、秘密情報を厳重に管理し、開示当事者の事前の書面による承諾なしに、第三者に開示又は漏洩してはならない。"
  },
  {
    "document": "秘密保持契約書",
    "title_number": "第 3条",
    "title": "目的外使用の禁止",
    "sentences": "受領当事者は、秘密情報を本目的以外のいかなる目的のためにも使用してはならない。"
  },
  {
    "document": "秘密保持契約書",
    "title_number": "第 4条",
    "title": "有効期間",
    "sentences": "本契約の有効期間は、本契約締結の日から 3年間とする。"
  },
  {
    "document": "秘密保持契約書",
    "title_number": "第 5条",
    "title": "準拠法および管轄",
    "sentences": "本契約は日本法に準拠し、これに従って解釈される。本契約に関する一切の紛争については、東京地方裁判所を第一審の専属的合意管轄裁判所とする。"
  }
]') EXTERN,
        document = 'JSONFile.JSONArray.document' : 'java.lang.String',
        title_number = 'JSONFile.JSONArray.title_number' : 'java.lang.String',
        title = 'JSONFile.JSONArray.title' : 'java.lang.String',
        sentences = 'JSONFile.JSONArray.sentences' : 'java.lang.String'
    )
    );

CHOWN admin WRAPPER JSON "源泉_JSON" LASTMODIFICATIONUSER admin;

