DROP VIEW IF EXISTS encpyrted CASCADE;

CREATE VIEW encpyrted AS SELECT encpyrt."Column0" AS "Column0", encpyrt."Column1" AS "Column1", encrypt('PBEWithMD5AndDES', encpyrt."Column1") AS encrypted, regexp(encpyrt."Column1", '.', 'v') AS with_function FROM encpyrt;

CHOWN admin VIEW encpyrted LASTMODIFICATIONUSER admin;

