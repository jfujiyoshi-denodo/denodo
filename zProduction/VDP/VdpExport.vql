ailure') OR first_notification_type in ('closeSession', 'logout', 'loginFailure'))) THEN max_date ELSE NULL END AS end_time FROM (SELECT first(sessions_instant_log_20260728160131555.notification_type) AS first_notification_type, last(sessions_instant_log_20260728160131555.notification_type) AS last_notification_type, last(sessions_instant_log_20260728160131555.connection_id) AS last_connection_id, sessions_instant_log_20260728160131555.connection_start_time_as_text, first(sessions_instant_log_20260728160131555.connection_end_time_as_text) AS first_connection_end_time_as_text, last(sessions_instant_log_20260728160131555.connection_end_time_as_text) AS last_connection_end_time_as_text, last(sessions_instant_log_20260728160131555.client_ip) AS last_client_ip, last(sessions_instant_log_20260728160131555.user_agent) AS last_user_agent, last(sessions_instant_log_20260728160131555.access_interface) AS last_access_interface, sessions_instant_log_20260728160131555.session_id, last(sessions_instant_log_20260728160131555.session_start_time_as_text) AS last_session_start_time_as_text, last(sessions_instant_log_20260728160131555.login) AS last_login, last(sessions_instant_log_20260728160131555.database_name) AS last_database_name, last(sessions_instant_log_20260728160131555.webservice_name) AS last_webservice_name, last(sessions_instant_log_20260728160131555.jms_queue_name) AS last_jms_queue_name, last(sessions_instant_log_20260728160131555.intermediate_client_ip) AS last_intermediate_client_ip, min(sessions_instant_log_20260728160131555.date) AS min_date, max(sessions_instant_log_20260728160131555.date) AS max_date FROM sessions_instant_log_20260728160131555 WHERE cw_search_start_date = to_timestamptz('yyyy-MM-dd', '1970-01-01') GROUP BY sessions_instant_log_20260728160131555.session_id, sessions_instant_log_20260728160131555.connection_start_time_as_text) CONTEXT ('I18N' = 'rfc_restful');

