# #######################################
# VIEWS of company
# #######################################
DROP VIEW IF EXISTS "派生_正式社名" CASCADE;

CREATE VIEW "派生_正式社名" DESCRIPTION = '派生_正式社名 ビューは、社名表記の揺らぎを正式な社名にひも付けて管理するためのビューです。各レコードは一意なキーとして利用可能な id、揺らぎを含む社名を格納する name、そして登記上または公式な場面で用いられる正式社名を格納する official_name という 3 つのテキスト項目で構成されています。

name 列には、略称、旧社名、表記ゆれ（「株式会社」の有無や前後位置、全角・半角、カタカナ・英字表記の違い、軽微な誤記など）を含む多様な社名表現が入り、それぞれに対応する公式な正式名称が official_name 列に格納されます。これにより、さまざまな入力パターンの社名を、契約書・請求書・法令対応などで利用される正式社名に統一するための基礎データとして機能します。

このビューは主に次のような用途で利用できます。

1. 社名の正規化・自動補完  
システムへの入力や外部データ取込時に、ユーザーが入力した揺らぎのある社名（name）から official_name を特定し、正式な社名へ自動変換・補完することで、帳票や画面表示を公式名称に統一できます。

2. 名寄せ・重複統合の精度向上  
取引先マスタ・顧客マスタなどで、同一企業が異なる表記で複数登録されている場合に、name と official_name の対応関係を利用してレコードを統合・名寄せすることで、データの重複やばらつきを削減できます。

3. 契約・請求・コンプライアンス対応  
契約書、請求書、見積書、発注書などの法的または対外的な文書を作成する際に、必ず official_name を使用するよう制御することで、登記上の正式名称に基づいた正確な書類発行を実現し、法令遵守や監査対応を支援します。

4. システム間連携・マスタ統合  
異なるシステム間で社名表記ルールが異なる場合でも、official_name を共通キーとして利用することで、データ連携・マスタ統合を容易にし、社内全体で一貫した社名管理を行うことができます。

このように、派生_正式社名 ビューは、社名の表記揺れを吸収し、正式社名に一本化するための中核的な参照ビューとして、データクレンジング、名寄せ処理、マスタ標準化、法令対応などの場面で活用できるデータ構造です。'  (
    id (description = '各レコードを識別するための一意なキー。'),
    name (description = '揺らぎを含む社名が含まれています。name列の正式名所がofficial_name列に記述されています。'),
    official_name (description = '登記上または公式な場面で用いられる正式社名を保持するフィールドであり、契約書、請求書、法令対応などで必要となる正式な名称管理の基礎情報として扱われます。')
 )
 AS SELECT "基本_社名".id AS id, "基本_社名".name AS name, enrich_ai(("基本_社名".name||'の正式社名を示して。会社名だけ表示し、それ以外の情報は表示しないこと。')) AS official_name FROM "基本_社名";

CHOWN admin VIEW "派生_正式社名" LASTMODIFICATIONUSER admin;

ALTER VIEW "派生_正式社名"
 LAYOUT ("基本_社名" = [20, 20, 200, 200]);

ALTER VIEW "派生_正式社名"
 CACHE FULL NO_STATUS
    BATCHSIZEINCACHE DEFAULT TIMETOLIVEINCACHE NOEXPIRE
    ONSCHEMACHANGE RECREATE INCREMENTAL_LOAD;

