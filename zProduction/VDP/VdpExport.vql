DROP VIEW IF EXISTS "基本_予算" CASCADE;

CREATE TABLE "基本_予算" I18N jp (
        yearmonth:text (sourcetypeid = '12'),
        branch_cd:text (sourcetypeid = '12'),
        budget:int (sourcetypeid = '4')
    )
    CACHE OFF
    TIMETOLIVEINCACHE DEFAULT
    ADD SEARCHMETHOD "源泉_予算"(
        I18N jp
        CONSTRAINTS (
             ADD yearmonth (any) OPT ANY
             ADD branch_cd (any) OPT ANY
             ADD budget (any) OPT ANY
        )
        OUTPUTLIST (branch_cd, budget, yearmonth
        )
        WRAPPER (custom "源泉_予算")
    );

CHOWN admin VIEW "基本_予算" LASTMODIFICATIONUSER admin;

DROP VIEW IF EXISTS "基本_売上" CASCADE;

CREATE TABLE "基本_売上" I18N jp (
        datetime:text (sourcetypeid = '-9', sourcetyperadix = '10', sourcetypedecimals = '0', sourcetypesize = '2147483647'),
        yearmonth:text (sourcetypeid = '-9', sourcetyperadix = '10', sourcetypedecimals = '0', sourcetypesize = '2147483647'),
        branch_cd:text (sourcetypeid = '-9', sourcetyperadix = '10', sourcetypedecimals = '0', sourcetypesize = '2147483647'),
        distributor_cd:text (sourcetypeid = '-9', sourcetyperadix = '10', sourcetypedecimals = '0', sourcetypesize = '2147483647'),
        product_cd:text (sourcetypeid = '-9', sourcetyperadix = '10', sourcetypedecimals = '0', sourcetypesize = '2147483647'),
        sales:decimal (sourcetypeid = '2', sourcetyperadix = '10')
    )
    CACHE OFF
    TIMETOLIVEINCACHE DEFAULT
    ADD SEARCHMETHOD sales(
        I18N jp
        CONSTRAINTS (
             ADD datetime (any) OPT ANY
             ADD yearmonth (any) OPT ANY
             ADD branch_cd (any) OPT ANY
             ADD distributor_cd (any) OPT ANY
             ADD product_cd (any) OPT ANY
             ADD sales (any) OPT ANY
        )
        OUTPUTLIST (branch_cd, datetime, distributor_cd, product_cd, sales, yearmonth
        )
        WRAPPER (jdbc sales)
    );

CHOWN admin VIEW "基本_売上" LASTMODIFICATIONUSER admin;

DROP VIEW IF EXISTS "基本_支店" CASCADE;

CREATE TABLE "基本_支店" I18N jp (
        branch_cd:text,
        branch:text,
        address:text
    )
    CACHE OFF
    TIMETOLIVEINCACHE DEFAULT
    ADD SEARCHMETHOD branches(
        I18N jp
        CONSTRAINTS (
             ADD branch_cd NOS ZERO ()
             ADD branch NOS ZERO ()
             ADD address NOS ZERO ()
        )
        OUTPUTLIST (address, branch, branch_cd
        )
        WRAPPER (mongodb branches)
    );

CHOWN admin VIEW "基本_支店" LASTMODIFICATIONUSER admin;

# #######################################
# VIEWS of demo0
# #######################################
DROP VIEW IF EXISTS "派生_月次支店売上" CASCADE;

CREATE VIEW "派生_月次支店売上" AS SELECT "基本_売上".yearmonth AS yearmonth, "基本_支店".branch_cd AS branch_cd, "基本_支店".branch AS branch, "基本_支店".address AS address, sum("基本_売上".sales) AS "月次支店売上" FROM "基本_売上" AS "基本_売上" INNER JOIN "基本_支店" AS "基本_支店" ON "基本_売上".branch_cd = "基本_支店".branch_cd  GROUP BY "基本_売上".yearmonth, "基本_支店".branch_cd, "基本_支店".branch, "基本_支店".address ORDER BY yearmonth ASC, branch_cd ASC;

ALTER VIEW "派生_月次支店売上"
 LAYOUT ("基本_売上" = [20, 20, 200, 200], "基本_支店" = [335, 30, 200, 200]);

CHOWN admin VIEW "派生_月次支店売上" LASTMODIFICATIONUSER admin;

DROP VIEW IF EXISTS "派生_月次支店予実比較" CASCADE;

CREATE VIEW "派生_月次支店予実比較" AS SELECT "派生_月次支店売上".yearmonth AS "対象年月", "派生_月次支店売上".branch_cd AS "支店コード", "派生_月次支店売上".branch AS "支店名", "派生_月次支店売上".address AS "支店住所", "派生_月次支店売上"."月次支店売上" AS "月次支店売上高", "基本_予算".budget AS "支店予算額", ("派生_月次支店売上"."月次支店売上"/"基本_予算".budget) AS "支店予算達成率" FROM "派生_月次支店売上" AS "派生_月次支店売上" INNER JOIN "基本_予算" AS "基本_予算" ON ("派生_月次支店売上".yearmonth = "基本_予算".yearmonth AND "派生_月次支店売上".branch_cd = "基本_予算".branch_cd) ;

ALTER VIEW "派生_月次支店予実比較"
 LAYOUT ("派生_月次支店売上" = [20, 20, 200, 200], "基本_予算" = [391, 21, 200, 200]);

CHOWN admin VIEW "派生_月次支店予実比較" LASTMODIFICATIONUSER admin;

