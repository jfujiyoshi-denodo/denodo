        branch_cd:text,
        branch:text,
        address:text
    )
    PRIMARY KEY ( 'branch_cd' )
    CACHE FULL NO_STATUS
    BATCHSIZEINCACHE DEFAULT
    TIMETOLIVEINCACHE NOEXPIRE
    ONSCHEMACHANGE RECREATE INCREMENTAL_LOAD
    ADD SEARCHMETHOD branches(
        I18N jp
        CONSTRAINTS (
             ADD branch_cd NOS ZERO ()
             ADD branch NOS ZERO ()
             ADD address NOS ZERO ()
        )
        OUTPUTLIST (address, branch, branch_cd
        )
        WRAPPER (mongodb branches)
    );

CHOWN admin VIEW "基本_支店" LASTMODIFICATIONUSER admin;

