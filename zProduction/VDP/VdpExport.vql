DROP VIEW IF EXISTS "サブコン英名_000" CASCADE;

CREATE VIEW "サブコン英名_000" FOLDER = '/2.基本ビュー' AS SELECT leftpad(cast('text', "サブコン英名".id), 3, '0') AS id, "サブコン英名".company AS company FROM "サブコン英名";

CHOWN admin VIEW "サブコン英名_000" LASTMODIFICATIONUSER admin;

ALTER VIEW "サブコン英名_000"
 LAYOUT ("サブコン英名" = [20, 20, 200, 200]);

DROP VIEW IF EXISTS "稼働管理表" CASCADE;

CREATE VIEW "稼働管理表" FOLDER = '/3.派生ビュー' (
    company TAGS (confidential),
    hour TAGS (confidential)
 )
 AS SELECT "稼働時間".date AS date, "稼働時間".project_id AS project_id, "プロジェクト".project AS project, "稼働時間".subconstructor_id AS subconstructor_id, "サブコン英名_000".company AS company, "稼働時間".hour AS hour, "サブコン".id AS id, "サブコン".company_jpn AS company_jpn FROM (("稼働時間" AS "稼働時間" INNER JOIN "プロジェクト" AS "プロジェクト" ON "稼働時間".project_id = "プロジェクト".id ) INNER JOIN "サブコン英名_000" AS "サブコン英名_000" ON "稼働時間".subconstructor_id = "サブコン英名_000".id ) INNER JOIN "サブコン" AS "サブコン" ON "稼働時間".subconstructor_id = "サブコン".id ;

ALTER VIEW "稼働管理表"
 LAYOUT ("稼働時間" = [20, 20, 200, 200], "プロジェクト" = [317, 1, 200, 200], "サブコン英名_000" = [371, 96, 200, 200], "サブコン" = [646, 94, 200, 200]);

CHOWN admin VIEW "稼働管理表" LASTMODIFICATIONUSER admin;

