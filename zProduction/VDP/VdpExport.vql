DROP VIEW IF EXISTS distributor_mst CASCADE;

CREATE TABLE distributor_mst I18N jp (
        distributor_cd:text (sourcetypeid = '-9', sourcetyperadix = '10', sourcetypedecimals = '0', sourcetypesize = '2147483647'),
        distributor:text (sourcetypeid = '-9', sourcetyperadix = '10', sourcetypedecimals = '0', sourcetypesize = '2147483647'),
        address:text (sourcetypeid = '-9', sourcetyperadix = '10', sourcetypedecimals = '0', sourcetypesize = '2147483647'),
        tel:text (sourcetypeid = '-9', sourcetyperadix = '10', sourcetypedecimals = '0', sourcetypesize = '2147483647')
    )
    CACHE OFF
    TIMETOLIVEINCACHE DEFAULT
    ADD SEARCHMETHOD distributor_mst(
        I18N jp
        CONSTRAINTS (
             ADD distributor_cd (any) OPT ANY
             ADD distributor (any) OPT ANY
             ADD address (any) OPT ANY
             ADD tel (any) OPT ANY
        )
        OUTPUTLIST (address, distributor, distributor_cd, tel
        )
        WRAPPER (jdbc distributor_mst)
    );

CHOWN "admin (smtoken)" VIEW distributor_mst LASTMODIFICATIONUSER "admin (smtoken)";

