DROP WRAPPER JDBC IF EXISTS company_master CASCADE;

CREATE WRAPPER JDBC company_master
    FOLDER = '/2.基本ビュー'
    DATASOURCENAME="マッピング"
    SCHEMANAME='public' ESCAPE
    RELATIONNAME='company_master' 
    OUTPUTSCHEMA (
        id = 'id' :'java.lang.Long' (OPT) (sourcetypedecimals='0', sourcetyperadix='10', sourcetypesize='19', sourcetypeid='-5', sourcetypename='int8')  NOT NULL NOT SORTABLE IS_AUTOINCREMENT,
        company = 'company' :'java.lang.String' (OPT) (sourcetypedecimals='0', sourcetyperadix='10', sourcetypesize='2147483647', sourcetypeid='12', sourcetypename='varchar')  SORTABLE
    )
    CONSTRAINT 'company_master_pkey' PRIMARY KEY ( 'id' )
    INDEX 'company_master_pkey' OTHER UNIQUE PRIMARY ( 'id' );

CHOWN admin WRAPPER JDBC company_master LASTMODIFICATIONUSER admin;

DROP WRAPPER JDBC IF EXISTS constructor_jpn_mst CASCADE;

CREATE WRAPPER JDBC constructor_jpn_mst
    FOLDER = '/2.基本ビュー'
    DATASOURCENAME="マッピング"
    SCHEMANAME='public' ESCAPE
    RELATIONNAME='constructor_jpn_mst' 
    OUTPUTSCHEMA (
        id = 'id' :'java.lang.String' (OPT) (sourcetypedecimals='0', sourcetyperadix='10', sourcetypesize='2147483647', sourcetypeid='12', sourcetypename='varchar')  NOT NULL SORTABLE,
        english = 'english' :'java.lang.String' (OPT) (sourcetypedecimals='0', sourcetyperadix='10', sourcetypesize='2147483647', sourcetypeid='12', sourcetypename='varchar')  SORTABLE,
        japanese = 'japanese' :'java.lang.String' (OPT) (sourcetypedecimals='0', sourcetyperadix='10', sourcetypesize='2147483647', sourcetypeid='12', sourcetypename='varchar')  SORTABLE
    )
    CONSTRAINT 'constructor_jpn_mst_pkey' PRIMARY KEY ( 'id' )
