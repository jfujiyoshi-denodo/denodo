CONNECT DATABASE ADMIN;

# #######################################
# USER PRIVILEGES
# #######################################
ALTER USER employee
GRANT ROLE allusers,denodo_users;

# #######################################
# ROLE PRIVILEGES
# #######################################
ALTER ROLE allusers
GRANT ADMIN ON admin;

ALTER ROLE denodo_users
GRANT CONNECT ON rfi2
GRANT METADATA, EXECUTE ON rfi2."rt_稼働管理表"
GRANT METADATA, EXECUTE ON rfi2."rt_稼働管理表_今月含む"
GRANT METADATA, EXECUTE ON rfi2."稼働管理表"
GRANT EXECUTE (date, project, company, japanese, subconstructor_id, project_id) ON rfi2."稼働管理表"
GRANT EXECUTE WHEN ANY(japanese, subconstructor_id, company) THEN 'GETSESSION(''ROLES'') = ''denodo_users''' MASKING WITH (REDACT_ASTERISK) (company WITH DEFAULT, subconstructor_id WITH DEFAULT, japanese WITH DEFAULT)  ON rfi2."稼働管理表";

ALTER ROLE employee
GRANT CONNECT, METADATA, EXECUTE ON demo;

