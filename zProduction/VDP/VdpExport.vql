DROP VIEW IF EXISTS "0.標準" CASCADE;

CREATE TABLE "0.標準" I18N jp (
        parentfolder:text (notnull, sourcetypeid = '12'),
        "relativePath":text (sourcetypeid = '12'),
        filename:text (sourcetypeid = '12'),
        extension:text (sourcetypeid = '12'),
        fullpath:text (sourcetypeid = '12'),
        filetype:text (sourcetypeid = '12'),
        hidden:boolean (sourcetypeid = '16'),
        datemodified:timestamp (sourcetypeid = '93'),
        canread:boolean (sourcetypeid = '16'),
        canwrite:boolean (sourcetypeid = '16'),
        canexecute:boolean (sourcetypeid = '16'),
        size:long (sourcetypeid = '-5'),
        recursive:boolean (sourcetypeid = '16'),
        binarycontents:blob (sourcetypeid = '2004'),
        textcontents:text (sourcetypeid = '12'),
        readencoding:text (sourcetypeid = '12'),
        append:boolean (sourcetypeid = '16'),
        overwrite:boolean (sourcetypeid = '16')
    )
    FOLDER = '/管理'
    CACHE OFF
    TIMETOLIVEINCACHE DEFAULT
    ADD SEARCHMETHOD "源泉_標準"(
        I18N jp
        CONSTRAINTS (
             ADD "relativePath" (any) OPT ANY
             ADD filename (any) OPT ANY
             ADD extension (any) OPT ANY
             ADD fullpath (any) OPT ANY
             ADD filetype (any) OPT ANY
             ADD hidden (any) OPT ANY
             ADD datemodified (any) OPT ANY
             ADD canread (any) OPT ANY
             ADD canwrite (any) OPT ANY
             ADD canexecute (any) OPT ANY
             ADD size (any) OPT ANY
             ADD textcontents (any) OPT ANY
             ADD readencoding (any) OPT ANY
             ADD parentfolder (=) OBL ONE
             ADD recursive (=) OBL ONE
             ADD binarycontents NOS ZERO ()
             ADD append NOS ZERO ()
             ADD overwrite NOS ZERO ()
        )
        OUTPUTLIST (append, binarycontents, canexecute, canread, canwrite, datemodified, extension, filename, filetype, fullpath, hidden, overwrite, parentfolder, readencoding, recursive, "relativePath", size, textcontents
        )
        WRAPPER (custom "源泉_標準")
    );

CHOWN admin VIEW "0.標準" LASTMODIFICATIONUSER admin;

DROP VIEW IF EXISTS "基本_JSON" CASCADE;

CREATE TABLE "基本_JSON" I18N jp (
        "JSON_INPUT":text (extern),
        parent:text,
        child:text,
        standard:text
    )
    FOLDER = '/管理'
    CACHE OFF
    TIMETOLIVEINCACHE DEFAULT
    ADD SEARCHMETHOD "源泉_JSON"(
        I18N jp
        CONSTRAINTS (
             ADD "JSON_INPUT" (=) OBL ONE
             ADD parent NOS ZERO ()
             ADD child NOS ZERO ()
             ADD standard NOS ZERO ()
        )
        OUTPUTLIST (child, parent, standard
        )
        WRAPPER (json "源泉_JSON")
    );

CHOWN admin VIEW "基本_JSON" LASTMODIFICATIONUSER admin;

# #######################################
# VIEWS of machine
# #######################################
DROP VIEW IF EXISTS "1.ファイル読込" CASCADE;

CREATE VIEW "1.ファイル読込" AS SELECT "0.標準".filename AS filename, "0.標準".binarycontents AS binarycontents, ('application/'||"0.標準".extension) AS content_type FROM "0.標準" WHERE (parentfolder = 'C:\data' AND recursive = true);

CHOWN admin VIEW "1.ファイル読込" LASTMODIFICATIONUSER admin;

ALTER VIEW "1.ファイル読込"
 LAYOUT ("0.標準" = [20, 20, 200, 200]);

DROP VIEW IF EXISTS "2.標準" CASCADE;

CREATE VIEW "2.標準" AS SELECT "1.ファイル読込".filename AS filename, "1.ファイル読込".binarycontents AS binarycontents, "1.ファイル読込".content_type AS content_type, enrich_ai_binary('ドキュメント全体を解析し、全ての子項目 (1-1等 )とそれが属する親項目 (1.等 )の階層構造を正確に特定してください。まずは、全ての階層を網羅した以下のJSON形式のリストを作成してください。フォーマット：[{"parent": "親項目名", "child": "子項目名","standard":"基準値"}, {"parent": "親項目名", "child": "子項目名","standard":"基準値"}...] ※挨拶や解説は一切含めず、このJSONリストを作成してください。', "1.ファイル読込".binarycontents, "1.ファイル読込".content_type) AS json_text FROM "1.ファイル読込";

CHOWN admin VIEW "2.標準" LASTMODIFICATIONUSER admin;

ALTER VIEW "2.標準"
 LAYOUT ("1.ファイル読込" = [20, 20, 200, 200]);

DROP VIEW IF EXISTS "3.構造化" CASCADE;

CREATE VIEW "3.構造化" FOLDER = '/管理' AS SELECT "基本_JSON".parent AS parent, "基本_JSON".child AS child, "基本_JSON".standard AS standard FROM "2.標準" AS "2.標準" INNER JOIN "基本_JSON" AS "基本_JSON" ON "2.標準".json_text = "基本_JSON"."JSON_INPUT" ;

ALTER VIEW "3.構造化"
 LAYOUT ("2.標準" = [20, 20, 200, 200], "基本_JSON" = [363, 26, 200, 200]);

CHOWN admin VIEW "3.構造化" LASTMODIFICATIONUSER admin;

DROP VIEW IF EXISTS "3.設置標準" CASCADE;

CREATE VIEW "3.設置標準" DESCRIPTION = '3.設置標準 ビューは、機械の設置基準に関わるデータが保管されています。

業務や評価の管理体系における各種項目について、「標準値」とその許容範囲（最小値・最大値）および単位を整理して保持するための基準テーブル的なビューです。「親項目」で上位カテゴリや評価領域を表し、その下に紐づく「子項目」で具体的な管理対象や評価軸を表現します。各子項目ごとに、想定される標準的な値を「標準値」として記録し、許容される範囲の下限を「最小値」、上限を「最大値」として定義します。また、「単位」フィールドにより、それらの数値が示す物理的・論理的な尺度（時間、長さ、量、割合など）を明示し、値の意味を一意に解釈できるように構造化されています。

この 3.設置標準 ビューは、業務プロセスや設備・品質・サービスなどの各種管理対象について、あらかじめ定められた基準値と許容範囲を一元的に管理・参照する用途に利用できます。これにより、計測・監視システムや点検・評価業務において、実測値や評価結果が基準内かどうかを判定したり、しきい値を超過した異常を検知したりする仕組みを構築しやすくなります。また、親項目／子項目の階層構造により、多様な評価軸を体系的に整理できるため、標準類やマニュアル、チェックリストの整備・維持管理、さらにはレポーティングやダッシュボードでの基準値表示などにも活用することが可能です。'  (
    "親項目" (description = '上位の管理カテゴリや評価項目を表すフィールドです。類似する複数の「子項目」をまとめる軸となる概念であり、標準値や許容範囲を設定する際の大枠の区分として利用されます。業務上の管理体系や評価体系を構造的に整理するための親レベルの項目です。'),
    "子項目" (description = '「親項目」にぶら下がる個別の評価軸や管理対象を表すフィールドです。具体的にどの内容について標準値や最小値・最大値が定められているかを識別します。詳細な管理粒度での基準や条件を明確化するための要素として用いられます。'),
    "標準値" (description = '各「子項目」に対して想定される標準値を示すフィールドです。'),
    "最小値" (description = '各「子項目」に許容される「最小値」を示すフィールドです。基準から見てどの程度まで低い値が受け入れ可能かを定義し、運用上の許容範囲や閾値を明確にするために使用されます。'),
    "最大値" (description = '各「子項目」に許容される「最大値」を示すフィールドです。どの水準を超えると基準から外れるかを明確にし、管理対象の過大・過剰な状態を判別するための上側の閾値を定義します。'),
    "単位" (description = '「標準値」「最小値」「最大値」で扱う数値の物理的・論理的な「単位」を示すフィールドです。測定対象の尺度（例：時間、長さ、量、率など）を明確にし、数値の意味を一意に解釈できるようにするための情報を保持します。')
 )
 AS SELECT "3.構造化".parent AS "親項目", "3.構造化".child AS "子項目", "3.構造化".standard AS "標準値", enrich_ai((("3.構造化".standard||'から数値を全て抽出してください。数値が複数抽出される場合は、最小の数値のみを表示してください。')||'説明文などは一切不要で、必ず数値だけを表示してください。')) AS "最小値", enrich_ai((("3.構造化".standard||'から数値を全て抽出してください。数値が複数抽出される場合は、最大の数値のみを表示してください。')||'説明文などは一切不要で、必ず数値だけを表示してください。')) AS "最大値", enrich_ai((("3.構造化".standard||'から数値に関わる単位の単語だけを表示してください。')||'説明文などは一切不要で、必ず数値に関わる単位の単語だけを1つ表示してください。よく内容を吟味して、単位にかかわる単語を慎重に探してください。')) AS "単位" FROM "3.構造化";

CHOWN admin VIEW "3.設置標準" LASTMODIFICATIONUSER admin;

ALTER VIEW "3.設置標準"
 LAYOUT ("3.構造化" = [20, 20, 200, 200]);

ALTER VIEW "3.設置標準"
