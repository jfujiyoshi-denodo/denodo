DROP VIEW IF EXISTS "サブコン英名000" CASCADE;

CREATE VIEW "サブコン英名000" FOLDER = '/2.基本ビュー' AS SELECT leftpad(cast('text', "サブコン英名".id), 3, '0') AS id, "サブコン英名".company AS company FROM "サブコン英名";

CHOWN admin VIEW "サブコン英名000" LASTMODIFICATIONUSER admin;

ALTER VIEW "サブコン英名000"
 LAYOUT ("サブコン英名" = [20, 20, 200, 200]);

ALTER VIEW "サブコン英名000"
 CACHE FULL NO_STATUS
    BATCHSIZEINCACHE DEFAULT TIMETOLIVEINCACHE NOEXPIRE
    ONSCHEMACHANGE RECREATE INCREMENTAL_LOAD;

DROP VIEW IF EXISTS "一旦UNION" CASCADE;

CREATE VIEW "一旦UNION" FOLDER = '/5.名寄せ' AS SELECT id, address FROM (SELECT address, id FROM "住所２" EXTENDED UNION ALL SELECT address, id FROM "住所１");

ALTER VIEW "一旦UNION"
 LAYOUT ("住所２" = [20, 20, 200, 200], "住所１" = [319, 33, 200, 200]);

CHOWN admin VIEW "一旦UNION" LASTMODIFICATIONUSER admin;

DROP VIEW IF EXISTS "稼働時間_j_プロジェクト" CASCADE;

CREATE VIEW "稼働時間_j_プロジェクト" FOLDER = '/2.基本ビュー' AS SELECT "稼働時間".date AS date, "稼働時間".project_id AS project_id, "稼働時間".subconstructor_id AS subconstructor_id, "稼働時間".hour AS hour, "プロジェクト".id AS id, "プロジェクト".project AS project FROM "稼働時間" AS "稼働時間" INNER JOIN "プロジェクト" AS "プロジェクト" ON "稼働時間".project_id = "プロジェクト".id ;

ALTER VIEW "稼働時間_j_プロジェクト"
 LAYOUT ("稼働時間" = [20, 20, 200, 200], "プロジェクト" = [397, 36, 200, 200]);

CHOWN admin VIEW "稼働時間_j_プロジェクト" LASTMODIFICATIONUSER admin;

DROP VIEW IF EXISTS "修正後住所" CASCADE;

CREATE VIEW "修正後住所" FOLDER = '/5.名寄せ' AS SELECT "一旦UNION".id AS id, "一旦UNION".address AS "旧住所", regexp((regexp(address, '[0-9０-９].*', '')||regexp(regexp(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(address, '０', '0'), '１', '1'), '２', '2'), '３', '3'), '４', '4'), '５', '5'), '６', '6'), '７', '7'), '８', '8'), '９', '9'), '^[^0-9]+', ''), '[^0-9]+', '-')), '-$', '') AS "新住所" FROM "一旦UNION";

CHOWN admin VIEW "修正後住所" LASTMODIFICATIONUSER admin;

ALTER VIEW "修正後住所"
 LAYOUT ("一旦UNION" = [20, 20, 200, 200]);

DROP VIEW IF EXISTS "稼働管理表" CASCADE;

CREATE VIEW "稼働管理表" FOLDER = '/3.派生ビュー' AS SELECT "稼働時間".date AS date, "稼働時間".project_id AS project_id, "プロジェクト".project AS project, "稼働時間".subconstructor_id AS subconstructor_id, "サブコン英名000".company AS company, "サブコン英和名".japanese AS japanese, "稼働時間".hour AS hour FROM (("稼働時間" AS "稼働時間" INNER JOIN "プロジェクト" AS "プロジェクト" ON "稼働時間".project_id = "プロジェクト".id ) INNER JOIN "サブコン英名000" AS "サブコン英名000" ON "稼働時間".subconstructor_id = "サブコン英名000".id ) INNER JOIN "サブコン英和名" AS "サブコン英和名" ON "サブコン英名000".company = "サブコン英和名".english  ORDER BY date DESC;

ALTER VIEW "稼働管理表"
 LAYOUT ("稼働時間" = [20, 20, 200, 200], "プロジェクト" = [357, 17, 200, 200], "サブコン英名000" = [361, 142, 200, 200], "サブコン英和名" = [657, 142, 200, 200]);

CHOWN admin VIEW "稼働管理表" LASTMODIFICATIONUSER admin;

DROP VIEW IF EXISTS "稼働管理表_DEMO" CASCADE;

CREATE VIEW "稼働管理表_DEMO" FOLDER = '/3.派生ビュー' DESCRIPTION = '稼働管理表_DEMO は、プロジェクトごとの日々の実作業時間（稼働実績）を、下請け業者や日本人担当者の情報とあわせて管理するためのビューです。各行は特定の「稼働日」に紐づく稼働記録を表し、「プロジェクトID」と「プロジェクト名」によってどの案件に対する作業かを特定します。また、「下請け業者ID」と「会社名」により、どの外部業者（取引先）がその作業を担当したかを示し、「日本人担当者名」によって日本側の窓口・担当者を明示します。これらに対して「稼働時間」で、実際に発生した作業時間数を定量的に記録する構成になっており、日別・プロジェクト別・業者別・担当者別に稼働実績を把握できる基礎データを提供します。

このビューは、主に以下のような用途で活用できます。

- 工数・コスト管理  
  プロジェクトID／プロジェクト名ごとに稼働時間を集計することで、案件別の工数実績や、外注費・人件費の算出に必要な基礎データとして利用できます。見積工数との乖離分析や、工数超過プロジェクトの特定にも役立ちます。

- プロジェクト進捗および負荷状況の可視化  
  稼働日単位での作業時間の推移から、プロジェクト進捗の偏りや、ピーク期間の把握が可能になります。担当者別・業者別にみることで、誰に負荷が集中しているか、どのプロジェクトが逼迫しているかを把握し、リソース配分の見直しに活かせます。

- 業者管理・パフォーマンス把握  
  下請け業者IDや会社名ごとに稼働実績を集計することで、発注量や実作業時間を可視化し、契約や請求の裏付けデータとして利用できます。また、業者ごとの稼働傾向や生産性（投入時間と成果物の比較）を評価する際の参考情報としても機能します。

- レポート・説明資料の作成  
  プロジェクト名・会社名・日本人担当者名が含まれているため、管理者やクライアント向けの稼働報告書、月次・週次レポート、対外説明用の資料を、人が理解しやすい形で作成する際の元データとして活用できます。

- スケジュール・リソース計画の改善  
  過去の稼働日と稼働時間の履歴を分析することで、今後のプロジェクト計画や要員・外注計画の精度向上に繋げられます。類似プロジェクトの実績工数を参照することで、より現実的なスケジュールや見積を作成することが可能になります。

このように、稼働管理表_DEMO は、日々の作業実績を多角的に分析・管理するための中核的な稼働データビューとして、工数管理、コスト管理、業者管理、リソースマネジメント、レポーティングなど幅広い業務に活用できる構造となっています。'  (
    "稼働日" (description = '作業やサービスが実際に行われた日付を記録するフィールドです。日別の稼働状況を把握し、工数集計やスケジュール管理、期間ごとの稼働傾向の把握に活用できる基礎的な日付情報を示します。'),
    "プロジェクトID" (description = '各プロジェクトを識別するための一意性のある識別子を保持するフィールドです。稼働情報をどのプロジェクトに紐づくものか整理し、プロジェクト単位での集計・分析・管理を可能にする基盤情報を表します。'),
    "プロジェクト名" (description = '「プロジェクトID」に対応するプロジェクトの名称を格納するフィールドです。稼働データを人間が直感的に理解しやすくし、報告書や一覧表示においてプロジェクト内容を識別しやすくするための説明的な名称情報です。'),
    "下請け業者ID" (description = '下請け業者を区別するための識別子を保持するフィールドです。どの稼働がどの下請け業者に紐づくかを明確にし、業者別の業務量管理やパフォーマンス把握、契約・請求管理の基礎となる参照情報を示します。'),
    "会社名" (description = '下請け業者IDなどで識別される取引先や組織の正式な名称を記録するフィールドです。稼働実績をどの会社が担当したかを視覚的に把握しやすくし、社外向け資料や内部管理資料での表示・集約に用いる基本的な属性情報です。'),
    "日本人担当者名" (description = '対象プロジェクトや稼働における日本人側の担当者名を保持するフィールドです。連絡窓口や責任者の特定、担当者別の稼働状況の把握、社内外のコミュニケーション管理に利用される人物情報を示します。'),
    "稼働時間" (description = '特定の稼働日・プロジェクト・会社などの条件において実際に作業に充てられた時間数を示すフィールドです。工数管理やコスト計算、生産性分析、負荷状況の把握などの基礎となる数量的な時間情報を表します。')
 )
 AS SELECT "稼働時間".date AS "稼働日", "稼働時間".project_id AS "プロジェクトID", "プロジェクト".project AS "プロジェクト名", "稼働時間".subconstructor_id AS "下請け業者ID", "サブコン英名000".company AS "会社名", "サブコン英和名".japanese AS "日本人担当者名", "稼働時間".hour AS "稼働時間" FROM (("稼働時間" AS "稼働時間" INNER JOIN "プロジェクト" AS "プロジェクト" ON "稼働時間".project_id = "プロジェクト".id ) INNER JOIN "サブコン英名000" AS "サブコン英名000" ON "稼働時間".subconstructor_id = "サブコン英名000".id ) INNER JOIN "サブコン英和名" AS "サブコン英和名" ON "サブコン英名000".company = "サブコン英和名".english  ORDER BY "稼働日" DESC;

ALTER VIEW "稼働管理表_DEMO"
 LAYOUT ("稼働時間" = [20, 20, 200, 200], "プロジェクト" = [357, 17, 200, 200], "サブコン英名000" = [361, 142, 200, 200], "サブコン英和名" = [657, 142, 200, 200]);

CHOWN admin VIEW "稼働管理表_DEMO" LASTMODIFICATIONUSER admin;

DROP VIEW IF EXISTS "今月_稼働管理表" CASCADE;

CREATE VIEW "今月_稼働管理表" FOLDER = '/3.派生ビュー' AS SELECT left("稼働管理表".date, 7) AS year_month, "稼働管理表".date AS date, "稼働管理表".project_id AS project_id, "稼働管理表".project AS project, "稼働管理表".subconstructor_id AS subconstructor_id, "稼働管理表".company AS company, "稼働管理表".japanese AS japanese, "稼働管理表".hour AS hour FROM "稼働管理表" WHERE date between firstdayofmonth(current_date()) AND lastdayofmonth(current_date()) ORDER BY date ASC;

CHOWN admin VIEW "今月_稼働管理表" LASTMODIFICATIONUSER admin;

ALTER VIEW "今月_稼働管理表"
 LAYOUT ("稼働管理表" = [20, 20, 200, 200]);

DROP VIEW IF EXISTS "rt_稼働管理表_今月含む" CASCADE;

CREATE VIEW "rt_稼働管理表_今月含む" FOLDER = '/4.スナップショット' AS SELECT year_month, project_id, project, subconstructor_id, company, japanese, sum(hour) AS "稼働時間" FROM (SELECT japanese, project_id, subconstructor_id, date, project, company, hour, year_month FROM "rt_稼働管理表" EXTENDED UNION ALL SELECT company, project_id, date, subconstructor_id, project, japanese, hour, year_month FROM "今月_稼働管理表") GROUP BY japanese, company, subconstructor_id, project, project_id, year_month ORDER BY year_month DESC;

ALTER VIEW "rt_稼働管理表_今月含む"
 LAYOUT ("rt_稼働管理表" = [20, 20, 200, 200], "今月_稼働管理表" = [398, 38, 200, 200]);

CHOWN admin VIEW "rt_稼働管理表_今月含む" LASTMODIFICATIONUSER admin;

