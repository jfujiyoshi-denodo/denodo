    PROPERTIES ('escapeSyntaxCallMode'='callIfNoReturn', 'reWriteBatchedInserts'='true')
    KERBEROSPROPERTIES ('jaasLogin'='false', 'user'='<user>')
    DATA_LOAD_CONFIGURATION (
        BATCHINSERTSIZE = 200
    );

CHOWN admin DATASOURCE JDBC "源泉_売上" LASTMODIFICATIONUSER admin;

