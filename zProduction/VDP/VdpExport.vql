DROP DATASOURCE MONGODB IF EXISTS "源泉_pj日報" CASCADE;

CREATE DATASOURCE MONGODB "源泉_pj日報"
    CONNECTION (
        HOST = 'localhost'
        PORT = 27017
    )
    POOL (
        MAXACTIVE = 100
        MINACTIVE = 0
        CONNECTTIMEOUT = 10000
        SOCKETTIMEOUT = 0
        WAITQUEUETIMEOUT = 120000
    );

CHOWN admin DATASOURCE MONGODB "源泉_pj日報" LASTMODIFICATIONUSER admin;

