DROP VIEW IF EXISTS "稼働時間" CASCADE;

CREATE TABLE "稼働時間" I18N jp (
        date:localdate (sourcetypeid = '91', sourcetyperadix = '10', sourcetypedecimals = '0', sourcetypesize = '13'),
        project_id:text (sourcetypeid = '-9', sourcetyperadix = '10', sourcetypedecimals = '0', sourcetypesize = '2147483647'),
        subconstructor_id:text (sourcetypeid = '-9', sourcetyperadix = '10', sourcetypedecimals = '0', sourcetypesize = '2147483647'),
        hour:decimal (sourcetypeid = '2', sourcetyperadix = '10')
    )
