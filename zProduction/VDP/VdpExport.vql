DROP VIEW IF EXISTS "基本_売上_キャッシュ" CASCADE;

CREATE VIEW "基本_売上_キャッシュ" AS SELECT "基本_売上".datetime AS datetime, "基本_売上".yearmonth AS yearmonth, "基本_売上".branch_cd AS branch_cd, "基本_売上".distributor_cd AS distributor_cd, "基本_売上".product_cd AS product_cd, "基本_売上".sales AS sales FROM "基本_売上";

CHOWN admin VIEW "基本_売上_キャッシュ" LASTMODIFICATIONUSER admin;

ALTER VIEW "基本_売上_キャッシュ"
 LAYOUT ("基本_売上" = [20, 20, 200, 200]);

ALTER VIEW "基本_売上_キャッシュ"
 CACHE FULL NO_STATUS
    BATCHSIZEINCACHE DEFAULT TIMETOLIVEINCACHE NOEXPIRE
    ONSCHEMACHANGE RECREATE INCREMENTAL_LOAD;

DROP VIEW IF EXISTS "派生_月次支店売上" CASCADE;

CREATE VIEW "派生_月次支店売上" DESCRIPTION = '派生_月次支店売上 ビューは、各支店の月次売上実績を集計して保持するビューである。  
「年月」を時間軸とし、「支店コード」「支店名」によって支店を特定し、「支店住所」により所在地情報を付与することで、時間（年月）×拠点（支店）×地域（住所）の三つの観点から売上を紐づけて確認できる構造になっている。  
「月次支店売上」には、特定の年月における各支店単位の売上金額が格納されており、支店別の業績規模や成長度合いを金額ベースで把握するための中核的な指標として機能する。

このビューは、主に以下のような目的で利用できる。

- 各支店の月次売上推移のトレンド分析（前月比・前年同月比などの比較）
- 支店間・エリア間の売上比較による好調拠点・不振拠点の把握
- 支店住所を用いた地域別・エリア別の売上分析やマーケット特性の把握
- 予算対比やKPI管理における支店別モニタリング指標としての活用
- 支店別評価・インセンティブ算定のための客観的な売上データ基盤
- 経営層・マネジメント向けの月次業績レポートやダッシュボードのデータソース

このように、派生_月次支店売上 は、支店単位の月次業績を時系列かつ地域の文脈を踏まえて分析・報告するための基盤ビューとして位置付けられる。' 
    PRIMARY KEY ( '年月' , '支店コード' ) (
    "年月" (description = '対象となる取引や集計が属する年と月を示す期間情報。月次ベースで支店売上を把握・比較するための時間軸として機能し、同一支店の推移や複数支店間の同月比較など、時系列での業績管理の基礎となるキーとなる。'),
    "支店コード" (description = '各支店を一意に識別するためのコード情報。社内の組織体系やマスタと連携して支店を特定する際に用いられ、売上データを正しい拠点に紐付けて管理するための識別子として機能する。'),
    "支店名" (description = '支店の正式名称を表す項目。支店コードと組み合わせることで、売上情報を人間にとって理解しやすい形で表示・報告する際の拠点名として利用され、地域別や組織別の状況把握に役立つ。'),
    "支店住所" (description = '各支店の所在地住所を表す情報。支店の地域的な位置付けやエリア別分析の基盤となり、地理的条件と売上状況を関連付けて把握する際の拠点ロケーション情報として機能する。'),
    "月次支店売上" (description = '特定の「年月」における各支店単位の売上金額を集計した数値。支店別の業績規模や成長状況を金額ベースで示し、期間比較や支店間比較など、収益面からのパフォーマンス評価の基礎となる指標である。')
 )
 AS SELECT "基本_売上".yearmonth AS "年月", "基本_支店".branch_cd AS "支店コード", "基本_支店".branch AS "支店名", "基本_支店".address AS "支店住所", sum("基本_売上".sales) AS "月次支店売上" FROM "基本_売上" AS "基本_売上" INNER JOIN "基本_支店" AS "基本_支店" ON "基本_売上".branch_cd = "基本_支店".branch_cd  GROUP BY "基本_売上".yearmonth, "基本_支店".branch_cd, "基本_支店".branch, "基本_支店".address;

ALTER VIEW "派生_月次支店売上"
 LAYOUT ("基本_売上" = [20, 20, 200, 200], "基本_支店" = [333, 27, 200, 200]);

ALTER VIEW "派生_月次支店売上"
 CACHE FULL NO_STATUS
    BATCHSIZEINCACHE DEFAULT TIMETOLIVEINCACHE NOEXPIRE
    ONSCHEMACHANGE RECREATE INCREMENTAL_LOAD;

CHOWN admin VIEW "派生_月次支店売上" LASTMODIFICATIONUSER admin;

DROP VIEW IF EXISTS "派生_月次支店予実比較" CASCADE;

CREATE VIEW "派生_月次支店予実比較" DESCRIPTION = '派生_月次支店売上_j_基本_予算 は、各支店の月次売上実績と、その月に設定された売上予算を支店情報とあわせて保持するビューである。  
年月を時間軸とし、支店コード・支店名・支店住所といった拠点属性をキーとして、以下のような情報を一行にまとめている。

- 年月：取引や売上集計が属する年と月を示す期間情報であり、月次ベースで支店の業績を整理する時間軸となる。  
- 支店コード：各支店を一意に識別するコードで、社内の組織マスタや他システムの支店情報と連携するための基本キーとして機能する。  
- 支店名：支店コードに対応する正式名称であり、人が理解しやすい形で拠点を識別するために用いられる。  
- 支店住所：支店の所在地を表す住所情報で、地域別・エリア別といった地理的な切り口で業績を分析するためのロケーション属性となる。  
- 月次支店売上：特定の年月における支店単位の売上実績金額で、支店別の収益規模や成長度合いを示す中心的な業績指標となる。  
- 月次支店予算：同じ年月に対して各支店に割り当てられた売上予算額であり、実績である月次支店売上と比較することで計画達成度や乖離状況を評価する基準となる。

このビューを利用することで、以下のような目的に活用できる。

1. 予実管理・達成度分析  
　月次支店売上（実績）と月次支店予算（計画）を同一レコード上で参照できるため、支店ごとの予算達成率や予算超過・未達状況の把握、乖離要因分析など、予実管理の基礎データとして利用できる。

2. 時系列での業績推移・トレンド分析  
　年月単位の履歴が蓄積されることで、支店別に売上・予算の推移を追跡し、成長トレンドや季節性、キャンペーン・施策の効果などを時系列で分析することができる。

3. 地域・エリア別の比較分析  
　支店住所を用いることで、エリア別・地域別・都市圏別といった地理的な集計や比較が可能となり、地域特性と業績（売上・予算）の関係を可視化する際の基盤データとして機能する。

4. 経営・営業向けレポートおよびダッシュボードの基盤  
　支店別・月次別の売上実績と予算情報を一元的に保持しているため、経営会議資料、営業部門の進捗レポート、ダッシュボード（KPIモニタリング画面）など、意思決定に必要な可視化や報告資料の土台となる。

5. 目標管理・人事評価・インセンティブ設計  
　支店別の売上と予算情報をもとに、各支店や担当組織の目標設定、評価指標（達成率・達成ランクなど）の算定、インセンティブや賞与算定のロジック設計などに活用できる。

このように、派生_月次支店売上_j_基本_予算 は、支店単位・月次単位での売上実績と予算を一体的に管理し、予実管理・時系列分析・地域別分析・レポーティング・評価指標算定など、幅広い業務領域での意思決定を支える基盤ビューとして位置付けられる。' 
    PRIMARY KEY ( '年月' , '支店コード' ) (
    "年月" (description = '取引や売上集計が属する年と月を示す期間情報。月次ベースで支店の業績を整理する時間軸として機能し、同一支店の推移比較や、各支店間の同一月の業績比較など、時系列での管理・評価の基盤となる。'),
    "支店コード" (description = '各支店を一意に識別するためのコード情報。社内の組織マスタや他システムの支店情報と連携し、売上や予算などの数値を正しい拠点に結び付けて管理するための基本的な識別キーとして利用される。'),
    "支店名" (description = '支店の正式名称を表す項目。支店コードで管理される情報に対して、人が認識しやすい拠点名を付与する役割を持ち、レポートやダッシュボード上での支店別状況の把握や説明に用いられる。'),
    "支店住所" (description = '各支店の所在地を表す住所情報。支店の地理的な位置付けを明確にし、エリア別・地域別の売上状況を捉える際のロケーション属性として機能し、地域特性と業績を関連付けて分析する基礎情報となる。') TAGS (confidential),
    "月次支店売上" (description = '特定の「年月」における各支店単位の売上金額を集計した数値。支店別の収益規模や成長度合いを金額ベースで示し、期間ごとの推移把握や支店間比較、収益性評価などにおける中心的な業績指標となる。'),
    "月次支店予算" (description = '特定の「年月」に対して各支店に割り当てられた月次の売上予算額を表す数値。実績である「月次支店売上」と比較することで、計画達成度や乖離状況を確認し、支店別の目標管理や業績評価の基準として用いられる。') TAGS (confidential),
    "予算達成率" (description = '特定の「年月」における各支店単位の予算達成率を集計した数値。支店別の収益規模や成長度合いを金額ベースで示し、期間ごとの推移把握や支店間比較、収益性評価などにおける中心的な業績指標となる。') TAGS (confidential)
 )
 AS SELECT "派生_月次支店売上"."年月" AS "年月", "派生_月次支店売上"."支店コード" AS "支店コード", "派生_月次支店売上"."支店名" AS "支店名", "派生_月次支店売上"."支店住所" AS "支店住所", "派生_月次支店売上"."月次支店売上" AS "月次支店売上", "基本_予算".budget AS "月次支店予算", ("派生_月次支店売上"."月次支店売上"/"基本_予算".budget) AS "予算達成率" FROM "派生_月次支店売上" AS "派生_月次支店売上" INNER JOIN "基本_予算" AS "基本_予算" ON ("派生_月次支店売上"."年月" = "基本_予算".yearmonth AND "派生_月次支店売上"."支店コード" = "基本_予算".branch_cd) ;

ALTER VIEW "派生_月次支店予実比較"
 LAYOUT ("派生_月次支店売上" = [20, 20, 200, 200], "基本_予算" = [362, 20, 200, 200]);

ALTER VIEW "派生_月次支店予実比較"
 CACHE FULL NO_STATUS
    BATCHSIZEINCACHE DEFAULT TIMETOLIVEINCACHE NOEXPIRE
    ONSCHEMACHANGE RECREATE INCREMENTAL_LOAD;

