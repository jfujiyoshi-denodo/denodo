# #######################################
# POLICY CREATION
# #######################################
DROP GLOBAL_SECURITY_POLICIES IF EXISTS (active_drectory, confidential);

CREATE GLOBAL_SECURITY_POLICIES (active_drectory
        ENABLED = TRUE
        AUDIENCE (
            ALL
            NOT_IN ABAC ('ad_groups' contains '["CN=denodo_users"]')
        )
        ELEMENTS (
            VIEW_DATABASES (rfi)
            ALL VIEWS
        )
        RESTRICTION (
            DENY 
        ),
    confidential
        ENABLED = TRUE
        AUDIENCE (
            ANY ROLES (allusers, denodo_users, employee)
        )
        ELEMENTS (
            ALL VIEWS
        )
        RESTRICTION (
            FILTER = ''
            MASKING ANY (confidential) WITH (REDACT) (numbers WITH HIDE, datetimes WITH ONLY_YEAR, texts WITH REDACT) 
        ));

CHOWNS (CHOWN admin GLOBAL_SECURITY_POLICY active_drectory LASTMODIFICATIONUSER admin, 
    CHOWN admin GLOBAL_SECURITY_POLICY confidential LASTMODIFICATIONUSER admin);

