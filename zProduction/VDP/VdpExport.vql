        state:text (sourcetypeid = '-9', sourcetyperadix = '10', sourcetypedecimals = '0', sourcetypesize = '10'),
        threadname:text (sourcetypeid = '-9', sourcetyperadix = '10', sourcetypedecimals = '0', sourcetypesize = '255'),
        threadid:long (sourcetypeid = '-5', sourcetyperadix = '10', sourcetypedecimals = '0', sourcetypesize = '19'),
        loglevel:text (sourcetypeid = '-9', sourcetyperadix = '10', sourcetypedecimals = '0', sourcetypesize = '10')
    )
    CONSTRAINT 'data_catalog_audit_logs_pkey' PRIMARY KEY ( 'id' )
    CACHE OFF
    TIMETOLIVEINCACHE DEFAULT
    ADD SEARCHMETHOD data_catalog_audit_logs(
        I18N jp
        CONSTRAINTS (
             ADD id (any) OPT ANY
             ADD starttime (any) OPT ANY
             ADD endtime (any) OPT ANY
             ADD elapsedtime (any) OPT ANY
             ADD sessionid (any) OPT ANY
             ADD clientip (any) OPT ANY
             ADD username (any) OPT ANY
             ADD userauthmethod (any) OPT ANY
             ADD userpermissions (any) OPT ANY
             ADD requesttype (any) OPT ANY
             ADD elementtypes (any) OPT ANY
             ADD affectedelements (any) OPT ANY
             ADD endpoint (any) OPT ANY
             ADD arguments (any) OPT ANY
             ADD state (any) OPT ANY
             ADD threadname (any) OPT ANY
             ADD threadid (any) OPT ANY
             ADD loglevel (any) OPT ANY
        )
        OUTPUTLIST (affectedelements, arguments, clientip, elapsedtime, elementtypes, endpoint, endtime, id, loglevel, requesttype, sessionid, starttime, state, threadid, threadname, userauthmethod, username, userpermissions
        )
        WRAPPER (jdbc data_catalog_audit_logs_0)
    );

