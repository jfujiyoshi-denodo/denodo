DROP VIEW IF EXISTS "rt_稼働管理表" CASCADE;

CREATE TABLE "rt_稼働管理表" I18N jp (
        year_month:text (sourcetypeid = '-9', sourcetyperadix = '10', sourcetypedecimals = '0', sourcetypesize = '2147483647'),
        date:localdate (sourcetypeid = '91', sourcetyperadix = '10', sourcetypedecimals = '0', sourcetypesize = '13'),
        project_id:text (sourcetypeid = '-9', sourcetyperadix = '10', sourcetypedecimals = '0', sourcetypesize = '2147483647'),
        project:text (sourcetypeid = '-9', sourcetyperadix = '10', sourcetypedecimals = '0', sourcetypesize = '2147483647'),
        subconstructor_id:text (sourcetypeid = '-9', sourcetyperadix = '10', sourcetypedecimals = '0', sourcetypesize = '2147483647'),
        company:text (sourcetypeid = '-9', sourcetyperadix = '10', sourcetypedecimals = '0', sourcetypesize = '2147483647'),
        japanese:text (sourcetypeid = '-9', sourcetyperadix = '10', sourcetypedecimals = '0', sourcetypesize = '2147483647'),
        hour:decimal (sourcetypeid = '2', sourcetyperadix = '10', sourcetypedecimals = '20', sourcetypesize = '38')
    )
    FOLDER = '/4.スナップショット'
    CACHE OFF
    TIMETOLIVEINCACHE DEFAULT
    ADD SEARCHMETHOD "rt_稼働管理表"(
        I18N jp
        CONSTRAINTS (
             ADD year_month (any) OPT ANY
             ADD date (any) OPT ANY
             ADD project_id (any) OPT ANY
             ADD project (any) OPT ANY
             ADD subconstructor_id (any) OPT ANY
             ADD company (any) OPT ANY
             ADD japanese (any) OPT ANY
             ADD hour (any) OPT ANY
        )
        OUTPUTLIST (company, date, hour, japanese, project, project_id, subconstructor_id, year_month
        )
        WRAPPER (jdbc "rt_稼働管理表")
    )
    DATA_LOAD_QUERY = 'SELECT ''2026-06'' as year_month, date, project_id, project, subconstructor_id, company, japanese, hour FROM rfi."稼働管理表" where date BETWEEN ''2026-01-01'' AND ''2026-01-31''';

CHOWN admin VIEW "rt_稼働管理表" LASTMODIFICATIONUSER admin;

DROP VIEW IF EXISTS "サブコン" CASCADE;

CREATE TABLE "サブコン" I18N jp (
        id:int,
        company:text,
        company_jpn:text
    )
    FOLDER = '/2.基本ビュー'
    CACHE OFF
    TIMETOLIVEINCACHE DEFAULT
    ADD SEARCHMETHOD "サブコン"(
        I18N jp
        CONSTRAINTS (
             ADD id NOS ZERO ()
             ADD company NOS ZERO ()
             ADD company_jpn NOS ZERO ()
        )
        OUTPUTLIST (company, company_jpn, id
        )
        WRAPPER (json "サブコン")
    );

CHOWN admin VIEW "サブコン" LASTMODIFICATIONUSER admin;

DROP VIEW IF EXISTS "サブコン和名" CASCADE;

CREATE TABLE "サブコン和名" I18N jp (
        id:text (notnull, sourcetypeid = '12', sourcetyperadix = '10', sourcetypedecimals = '0', sourcetypesize = '2147483647'),
        english:text (sourcetypeid = '12', sourcetyperadix = '10', sourcetypedecimals = '0', sourcetypesize = '2147483647'),
        japanese:text (sourcetypeid = '12', sourcetyperadix = '10', sourcetypedecimals = '0', sourcetypesize = '2147483647')
    )
    FOLDER = '/2.基本ビュー'
    CONSTRAINT 'constructor_jpn_mst_pkey' PRIMARY KEY ( 'id' )
    CACHE OFF
    TIMETOLIVEINCACHE DEFAULT
    ADD SEARCHMETHOD constructor_jpn_mst(
        I18N jp
        CONSTRAINTS (
             ADD id (any) OPT ANY
             ADD english (any) OPT ANY
             ADD japanese (any) OPT ANY
        )
        OUTPUTLIST (english, id, japanese
        )
        WRAPPER (jdbc constructor_jpn_mst)
    );

CHOWN admin VIEW "サブコン和名" LASTMODIFICATIONUSER admin;

DROP VIEW IF EXISTS "サブコン英名" CASCADE;

CREATE TABLE "サブコン英名" I18N jp (
        id:long (notnull, autoincrement, sourcetypeid = '-5', sourcetyperadix = '10', sourcetypedecimals = '0', sourcetypesize = '19'),
        company:text (sourcetypeid = '12', sourcetyperadix = '10', sourcetypedecimals = '0', sourcetypesize = '2147483647')
    )
    FOLDER = '/2.基本ビュー'
    CONSTRAINT 'company_master_pkey' PRIMARY KEY ( 'id' )
    CACHE OFF
    TIMETOLIVEINCACHE DEFAULT
    ADD SEARCHMETHOD company_master(
        I18N jp
        CONSTRAINTS (
             ADD id (any) OPT ANY
             ADD company (any) OPT ANY
        )
        OUTPUTLIST (company, id
        )
