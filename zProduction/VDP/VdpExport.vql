# #######################################
# DATABASE of address
# #######################################
DROP DATABASE IF EXISTS address;

CREATE DATABASE address '';

CONNECT DATABASE address;

# #######################################
# RESOURCES of address
# #######################################
# No vault resources in database address
# #######################################
# LISTENERS JMS of address
# #######################################
# No listeners jms in database address
# #######################################
# LISTENERS KAFKA of address
# #######################################
# No listeners kafka in database address
# #######################################
# DATASOURCES of address
# #######################################
DROP DATASOURCE DF IF EXISTS test CASCADE;

CREATE DATASOURCE DF test
    ROUTE LOCAL 'LocalConnection' 'C:/data/data.csv' URIPATTERN = '' FILENAMEPATTERN = ''
    CHARSET = 'UTF-8'
    COLUMNDELIMITER = ','
    ENDOFLINEDELIMITER = '\n'
    HEADER = FALSE;

CHOWN admin DATASOURCE DF test LASTMODIFICATIONUSER admin;

DROP DATASOURCE DF IF EXISTS "数字" CASCADE;

CREATE DATASOURCE DF "数字"
    ROUTE LOCAL 'LocalConnection' 'C:/Users/JunyaFujiyoshi/Desktop/イベント/アーキテクトコース/数字.txt' URIPATTERN = '' FILENAMEPATTERN = ''
    CHARSET = 'UTF-8'
    COLUMNDELIMITER = ','
    ENDOFLINEDELIMITER = '\n'
    HEADER = FALSE;

CHOWN admin DATASOURCE DF "数字" LASTMODIFICATIONUSER admin;

DROP DATASOURCE DF IF EXISTS "源泉_住所" CASCADE;

CREATE DATASOURCE DF "源泉_住所"
    ROUTE LOCAL 'LocalConnection' 'C:/Users/JunyaFujiyoshi/Desktop/イベント/アーキテクトコース/住所.txt' URIPATTERN = '' FILENAMEPATTERN = ''
    CHARSET = 'UTF-8'
    COLUMNDELIMITER = ','
    ENDOFLINEDELIMITER = '\n'
    HEADER = FALSE;

CHOWN admin DATASOURCE DF "源泉_住所" LASTMODIFICATIONUSER admin;

# #######################################
# DATABASE CONFIGURATION
# #######################################
ALTER DATABASE address
  CHARSET UNICODE;

# #######################################
# WRAPPERS of address
# #######################################
DROP WRAPPER DF IF EXISTS test CASCADE;

CREATE WRAPPER DF test
    DATASOURCENAME=test
    OUTPUTSCHEMA (
        "Column0" = 'Column0'
    );

CHOWN admin WRAPPER DF test LASTMODIFICATIONUSER admin;

DROP WRAPPER DF IF EXISTS "数字" CASCADE;

CREATE WRAPPER DF "数字"
    DATASOURCENAME="数字"
    OUTPUTSCHEMA (
        old = 'Column0',
        new = 'Column1'
    );

CHOWN admin WRAPPER DF "数字" LASTMODIFICATIONUSER admin;

DROP WRAPPER DF IF EXISTS "源泉_住所" CASCADE;

CREATE WRAPPER DF "源泉_住所"
    DATASOURCENAME="源泉_住所"
    OUTPUTSCHEMA (
        address = 'Column0'
    );

CHOWN admin WRAPPER DF "源泉_住所" LASTMODIFICATIONUSER admin;

# #######################################
# STORED PROCEDURES of address
# #######################################
# No stored procedures in database address
# #######################################
# TYPES of address
# #######################################
# No types in database address
# #######################################
# MAPS of address
# #######################################
# No maps in database address
# #######################################
# BASE VIEWS of address
# #######################################
DROP VIEW IF EXISTS test CASCADE;

CREATE TABLE test I18N jp (
        "Column0":text
    )
    CACHE OFF
    TIMETOLIVEINCACHE DEFAULT
    ADD SEARCHMETHOD test(
        I18N jp
        CONSTRAINTS (
             ADD "Column0" NOS ZERO ()
        )
        OUTPUTLIST ("Column0"
        )
        WRAPPER (df test)
    );

CHOWN admin VIEW test LASTMODIFICATIONUSER admin;

DROP VIEW IF EXISTS "基本_住所" CASCADE;

CREATE TABLE "基本_住所" I18N jp (
        address:text
    )
    CACHE OFF
    TIMETOLIVEINCACHE DEFAULT
    ADD SEARCHMETHOD "源泉_住所"(
        I18N jp
        CONSTRAINTS (
             ADD address NOS ZERO ()
        )
        OUTPUTLIST (address
        )
        WRAPPER (df "源泉_住所")
    );

CHOWN admin VIEW "基本_住所" LASTMODIFICATIONUSER admin;

DROP VIEW IF EXISTS "基本_数字" CASCADE;

CREATE TABLE "基本_数字" I18N jp (
        old:text,
        new:text
    )
    CACHE OFF
    TIMETOLIVEINCACHE DEFAULT
    ADD SEARCHMETHOD "数字"(
        I18N jp
        CONSTRAINTS (
             ADD old NOS ZERO ()
             ADD new NOS ZERO ()
        )
        OUTPUTLIST (new, old
        )
        WRAPPER (df "数字")
    );

CHOWN admin VIEW "基本_数字" LASTMODIFICATIONUSER admin;

# #######################################
# VIEWS of address
# #######################################
DROP VIEW IF EXISTS "修正後_住所" CASCADE;

CREATE VIEW "修正後_住所" AS SELECT "基本_住所".address AS address, regexp((regexp(address, '[0-9０-９].*', '')||regexp(regexp(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(address, '０', '0'), '１', '1'), '２', '2'), '３', '3'), '４', '4'), '５', '5'), '６', '6'), '７', '7'), '８', '8'), '９', '9'), '^[^0-9]+', ''), '[^0-9]+', '-')), '-$', '') AS modified FROM "基本_住所";

CHOWN admin VIEW "修正後_住所" LASTMODIFICATIONUSER admin;

ALTER VIEW "修正後_住所"
 LAYOUT ("基本_住所" = [20, 20, 200, 200]);

# #######################################
# ASSOCIATIONS of address
# #######################################
# No associations in database address
# #######################################
# WEBSERVICES of address
# #######################################
# No web services in database address
# #######################################
# WEBCONTAINER WEB SERVICE DEPLOYMENTS of address
# #######################################
# No deployed web services in database address
# #######################################
# VIEW STATISTICS of address
# #######################################
# No statistics in database address
# #######################################
# Closing connection with database address
# #######################################
CLOSE;


