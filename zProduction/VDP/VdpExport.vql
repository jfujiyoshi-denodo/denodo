  CHARSET UNICODE;

# #######################################
# WRAPPERS of a_staging
# #######################################
DROP WRAPPER JDBC IF EXISTS distributor_mst CASCADE;

CREATE WRAPPER JDBC distributor_mst
    DATASOURCENAME=postgres
    SCHEMANAME='public' ESCAPE
    RELATIONNAME='distributor_mst' 
    OUTPUTSCHEMA (
        distributor_cd = 'distributor_cd' :'java.lang.String' (OPT) (sourcetypedecimals='0', sourcetyperadix='10', sourcetypesize='2147483647', sourcetypeid='12', sourcetypename='varchar')  SORTABLE,
        distributor = 'distributor' :'java.lang.String' (OPT) (sourcetypedecimals='0', sourcetyperadix='10', sourcetypesize='2147483647', sourcetypeid='12', sourcetypename='varchar')  SORTABLE,
        address = 'address' :'java.lang.String' (OPT) (sourcetypedecimals='0', sourcetyperadix='10', sourcetypesize='2147483647', sourcetypeid='12', sourcetypename='varchar')  SORTABLE,
        tel = 'tel' :'java.lang.String' (OPT) (sourcetypedecimals='0', sourcetyperadix='10', sourcetypesize='2147483647', sourcetypeid='12', sourcetypename='varchar')  SORTABLE
    );

CHOWN "admin (smtoken)" WRAPPER JDBC distributor_mst LASTMODIFICATIONUSER "admin (smtoken)";

