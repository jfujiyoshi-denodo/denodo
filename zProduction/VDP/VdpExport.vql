# #######################################
# BASE VIEWS of contract
# #######################################
DROP VIEW IF EXISTS "0.標準" CASCADE;

CREATE TABLE "0.標準" I18N jp (
        parentfolder:text (notnull, sourcetypeid = '12'),
        "relativePath":text (sourcetypeid = '12'),
        filename:text (sourcetypeid = '12'),
        extension:text (sourcetypeid = '12'),
        fullpath:text (sourcetypeid = '12'),
        filetype:text (sourcetypeid = '12'),
        hidden:boolean (sourcetypeid = '16'),
        datemodified:timestamp (sourcetypeid = '93'),
        canread:boolean (sourcetypeid = '16'),
        canwrite:boolean (sourcetypeid = '16'),
        canexecute:boolean (sourcetypeid = '16'),
        size:long (sourcetypeid = '-5'),
        recursive:boolean (sourcetypeid = '16'),
        binarycontents:blob (sourcetypeid = '2004'),
        textcontents:text (sourcetypeid = '12'),
        readencoding:text (sourcetypeid = '12'),
        append:boolean (sourcetypeid = '16'),
        overwrite:boolean (sourcetypeid = '16')
    )
    FOLDER = '/管理'
    CACHE OFF
    TIMETOLIVEINCACHE DEFAULT
    ADD SEARCHMETHOD "源泉_標準"(
        I18N jp
        CONSTRAINTS (
             ADD "relativePath" (any) OPT ANY
             ADD filename (any) OPT ANY
             ADD extension (any) OPT ANY
             ADD fullpath (any) OPT ANY
             ADD filetype (any) OPT ANY
             ADD hidden (any) OPT ANY
             ADD datemodified (any) OPT ANY
             ADD canread (any) OPT ANY
             ADD canwrite (any) OPT ANY
             ADD canexecute (any) OPT ANY
             ADD size (any) OPT ANY
             ADD textcontents (any) OPT ANY
             ADD readencoding (any) OPT ANY
             ADD parentfolder (=) OBL ONE
             ADD recursive (=) OBL ONE
             ADD binarycontents NOS ZERO ()
             ADD append NOS ZERO ()
             ADD overwrite NOS ZERO ()
        )
        OUTPUTLIST (append, binarycontents, canexecute, canread, canwrite, datemodified, extension, filename, filetype, fullpath, hidden, overwrite, parentfolder, readencoding, recursive, "relativePath", size, textcontents
        )
        WRAPPER (custom "源泉_標準")
    );

CHOWN admin VIEW "0.標準" LASTMODIFICATIONUSER admin;

DROP VIEW IF EXISTS "源泉_JSON" CASCADE;

CREATE TABLE "源泉_JSON" I18N jp (
        "JSON_INPUT":text (extern),
        document:text,
        title_number:text,
        title:text,
        sentences:text
    )
    FOLDER = '/管理'
    CACHE OFF
    TIMETOLIVEINCACHE DEFAULT
    ADD SEARCHMETHOD "源泉_JSON"(
        I18N jp
        CONSTRAINTS (
             ADD "JSON_INPUT" (=) OBL ONE
             ADD document NOS ZERO ()
             ADD title_number NOS ZERO ()
             ADD title NOS ZERO ()
             ADD sentences NOS ZERO ()
        )
        OUTPUTLIST (document, sentences, title, title_number
        )
        WRAPPER (json "源泉_JSON")
    );

CHOWN admin VIEW "源泉_JSON" LASTMODIFICATIONUSER admin;

# #######################################
# VIEWS of contract
# #######################################
DROP VIEW IF EXISTS "1.ファイル読込" CASCADE;

CREATE VIEW "1.ファイル読込" AS SELECT contruct."0.標準".filename AS filename, contruct."0.標準".binarycontents AS binarycontents, ('application/'||contruct."0.標準".extension) AS content_type FROM contruct."0.標準" WHERE (parentfolder = 'C:\data' AND recursive = true);

CHOWN admin VIEW "1.ファイル読込" LASTMODIFICATIONUSER admin;

ALTER VIEW "1.ファイル読込"
 LAYOUT ("0.標準" = [20, 20, 200, 200]);

ALTER VIEW "1.ファイル読込"
 CACHE FULL NO_STATUS
    BATCHSIZEINCACHE DEFAULT TIMETOLIVEINCACHE NOEXPIRE
    ONSCHEMACHANGE RECREATE INCREMENTAL_LOAD;

DROP VIEW IF EXISTS "2.配列" CASCADE;

CREATE VIEW "2.配列" AS SELECT contruct."1.ファイル読込".filename AS filename, contruct."1.ファイル読込".binarycontents AS binarycontents, contruct."1.ファイル読込".content_type AS content_type, enrich_ai_binary('ドキュメント全体を解析し、ドキュメント全体が日本語の場合は、１行目のドキュメント全体のタイトルを1つ目、第X条などの条項を２つ目、条項に続く条文見出しを３つ目、各条項の中の文章を４つ目の要素として配列を作って。一方、ドキュメント全体を解析し、ドキュメント全体が英語語の場合は、１行目のドキュメント全体のタイトルを1つ目、Article Xなどのtitle numberを２つ目、title numberに続くtitleを３つ目、各titleの中の文章を４つ目の要素として、配列を作って。[[XX,XX,XX],[XX,XX,XX]...]の配列の要素だけあればよくて、それ以外の情報不要', contruct."1.ファイル読込".binarycontents, contruct."1.ファイル読込".content_type) AS array FROM contruct."1.ファイル読込";

CHOWN admin VIEW "2.配列" LASTMODIFICATIONUSER admin;

ALTER VIEW "2.配列"
 LAYOUT ("1.ファイル読込" = [20, 20, 200, 200]);

ALTER VIEW "2.配列"
 CACHE FULL NO_STATUS
    BATCHSIZEINCACHE DEFAULT TIMETOLIVEINCACHE NOEXPIRE
    ONSCHEMACHANGE RECREATE INCREMENTAL_LOAD;

DROP VIEW IF EXISTS "3.JSON" CASCADE;

CREATE VIEW "3.JSON" AS SELECT contruct."2.配列".filename AS filename, contruct."2.配列".binarycontents AS binarycontents, contruct."2.配列".content_type AS content_type, enrich_ai((contruct."2.配列".array||'の内容を読み取って、各配列の中身を、0から順に3までを、下記のJSON書式に組み立てなおして。[{"document":配列の0つ目の要素, "title_number":配列の1つ目の要素 ,"title":配列の2つ目の要素,"sentences";配列の3つ目の要素},{"document":配列の0つ目の要素, "title_number":配列の1つ目の要素 ,"title":配列の2つ目の要素,"sentences";配列の3つ目の要素}...]。文章を丁寧に読み取って、条項やtitle numberを絶対に読み落とさず正確に処理すること。あくまでJSONのデータの部分だけが必要で、それ以外の余計な言葉や文章をJSONデータの前後につけたりしないで。文章の中に金額に関する情報がある場合は、金額を全てアスタリスク(*)に置き換えて、金額の情報は絶対に分からないように加工して（年月日に関わる部分はマスクしなくても大丈夫）。株式会社名に関わる情報がある場合も、会社名の部分を全てアスタリスク(*)に置き換えて、会社名の情報は絶対に分からないように加工して')) AS json FROM contruct."2.配列";

CHOWN admin VIEW "3.JSON" LASTMODIFICATIONUSER admin;

ALTER VIEW "3.JSON"
 LAYOUT ("2.配列" = [20, 20, 200, 200]);

ALTER VIEW "3.JSON"
 CACHE FULL NO_STATUS
    BATCHSIZEINCACHE DEFAULT TIMETOLIVEINCACHE NOEXPIRE
    ONSCHEMACHANGE RECREATE INCREMENTAL_LOAD;

DROP VIEW IF EXISTS "4.JSONを構造化" CASCADE;

CREATE VIEW "4.JSONを構造化" AS SELECT "3.JSON".filename AS filename, "3.JSON".binarycontents AS binarycontents, "3.JSON".content_type AS content_type, "3.JSON".json AS json, "源泉_JSON"."JSON_INPUT" AS "JSON_INPUT", "源泉_JSON".document AS document, "源泉_JSON".title_number AS title_number, "源泉_JSON".title AS title, "源泉_JSON".sentences AS sentences FROM contruct."3.JSON" AS "3.JSON" INNER JOIN contruct."源泉_JSON" AS "源泉_JSON" ON "3.JSON".json = "源泉_JSON"."JSON_INPUT" ;

ALTER VIEW "4.JSONを構造化"
 LAYOUT ("3.JSON" = [20, 20, 200, 200], "源泉_JSON" = [319, 30, 200, 200]);

ALTER VIEW "4.JSONを構造化"
 CACHE FULL NO_STATUS
    BATCHSIZEINCACHE DEFAULT TIMETOLIVEINCACHE NOEXPIRE
    ONSCHEMACHANGE RECREATE INCREMENTAL_LOAD;

CHOWN admin VIEW "4.JSONを構造化" LASTMODIFICATIONUSER admin;

DROP VIEW IF EXISTS "5.契約書関連" CASCADE;

CREATE VIEW "5.契約書関連" DESCRIPTION = '「秘密保持契約書」、「物品売買契約書」、「秘密保持契約書」、「NON-DISCLOSURE AGREEMENT」（略称：NDA）に関わる情報が入っているビュー。
「項目名」フィールドは、各契約書に必須の項目一覧がはいっている。契約書に必よな項目に関して聞かれたら、契約書名とそれに関連する項目名を必ず答えること。
'  (
    "契約書名" (description = '対象となる契約書の正式名称やタイトルを保持するフィールドです。契約全体を識別するための名称であり、同一契約書内の各「項番」や「項目名」と紐づけて管理する際の基点となります。'),
    "項番" (description = '契約書内の各条・項・節などの順序や位置を示すための番号情報を保持するフィールドです。契約内容を体系的に整理し、「項目名」や「項目毎契約内容」との対応関係を明確にする役割を持ちます。'),
    "項目名" (description = '各「項番」に対応する条文やセクションの名称・見出しを保持するフィールドです。契約内容のテーマや対象事項を短く表現し、契約書構成の理解や参照性を高めるために用いられます。'),
    "項目毎契約内容" (description = '各「項目名」に対応する具体的な契約条件・条文テキストを保持するフィールドです。権利義務、条件、期間、金額、手続きなど、その項目に関する詳細な取り決め内容を記録します。')
 )
 AS SELECT contruct."4.JSONを構造化".document AS "契約書名", contruct."4.JSONを構造化".title_number AS "項番", contruct."4.JSONを構造化".title AS "項目名", contruct."4.JSONを構造化".sentences AS "項目毎契約内容" FROM contruct."4.JSONを構造化";

CHOWN admin VIEW "5.契約書関連" LASTMODIFICATIONUSER admin;

ALTER VIEW "5.契約書関連"
 LAYOUT ("4.JSONを構造化" = [20, 20, 200, 200]);

